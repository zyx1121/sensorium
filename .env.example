# Shared by apps/ingest, apps/mcp and packages/db (migration runner / CLI).
DATABASE_URL=postgres://user:password@localhost:5432/sensorium

# Retention, applied by `bun run db:retention` (systemd timer, see deploy/).
# Metrics expire by dropping whole day partitions; spans and logs by DELETE.
# Size the metric window against throughput, not intuition: one busy PVE
# project writes ~2.4GB/day, so the 14-day default is ~33GB on disk.
# AHEAD_DAYS is how far ahead partitions are pre-created — it is the slack the
# system has if the timer stops running.
SENSORIUM_RETENTION_METRIC_DAYS=14
SENSORIUM_RETENTION_SPAN_DAYS=30
SENSORIUM_RETENTION_LOG_DAYS=30
SENSORIUM_RETENTION_AHEAD_DAYS=7

# apps/ingest — HTTP port for the OTLP/HTTP receiver.
PORT=8787

# apps/mcp — HTTP port for the MCP endpoint, and the single bearer token that
# gates it (one trusted consumer: kilo). Generate with e.g. `openssl rand -hex 32`.
MCP_PORT=8788
SENSORIUM_MCP_TOKEN=

# Per-project ingest tokens are NOT env vars — they're generated and rotated
# with `bun run db:register-project <project-name>`, which prints the
# plaintext token once (only its sha256 hash is stored in `projects`).
# Producers send it as `Authorization: Bearer <token>` to apps/ingest, or a
# collector.yaml (see collector/README.md) forwards it on their behalf via
# SENSORIUM_INGEST_TOKEN:
SENSORIUM_INGEST_TOKEN=
