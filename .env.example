# Copy to .env and fill in the blanks. Docker Compose (compose.yaml) reads it,
# and so does a run from source.

# --- Docker Compose ---------------------------------------------------------

# The image tag compose.yaml runs: a release such as 0.1.0, or latest.
SENSORIUM_VERSION=latest

# The password of the bundled Postgres. compose.yaml builds DATABASE_URL from
# it, so DATABASE_URL below only matters for a run from source.
POSTGRES_PASSWORD=

# Where compose.yaml publishes the two ports. 127.0.0.1 keeps them for a
# reverse proxy on the same machine; 0.0.0.0 exposes plain HTTP to the network.
SENSORIUM_BIND=127.0.0.1
SENSORIUM_INGEST_PORT=8787
SENSORIUM_MCP_PORT=8788

# --- Every run --------------------------------------------------------------

# The single bearer token that gates the MCP endpoint: every agent that reads
# sensorium sends it. Generate one with `openssl rand -hex 32`.
SENSORIUM_MCP_TOKEN=

# Retention, applied by the retention sweep (the retention service in
# compose.yaml, or the systemd timer in deploy/). Metrics expire by dropping
# whole day partitions; spans and logs by DELETE. Size the metric window
# against throughput, not intuition: one busy Proxmox host writes ~2.4GB of
# metrics a day, so 14 days is ~33GB on disk. AHEAD_DAYS is how far ahead
# partitions are created, the slack the system has if the sweep stops.
SENSORIUM_RETENTION_METRIC_DAYS=14
SENSORIUM_RETENTION_SPAN_DAYS=30
SENSORIUM_RETENTION_LOG_DAYS=30
SENSORIUM_RETENTION_AHEAD_DAYS=7

# --- A run from source ------------------------------------------------------

# Shared by apps/ingest, apps/mcp and packages/db (migration runner / CLI).
DATABASE_URL=postgres://user:password@localhost:5432/sensorium

# HTTP ports of the OTLP/HTTP receiver (apps/ingest) and the MCP endpoint
# (apps/mcp). compose.yaml sets its own.
PORT=8787
MCP_PORT=8788

# --- Optional ---------------------------------------------------------------

# 1 serves sensorium.zyx.tw's landing page at / (and /index.md). It carries
# zyx.tw's frame and links, so leave it unset on any other instance, which then
# answers / with a 404.
SENSORIUM_LANDING=

# Per-project ingest tokens are NOT env vars: `register-project <name>` prints
# one once (only its sha256 hash is stored in `projects`), and running it again
# for the same name rotates it. Producers send it as
# `Authorization: Bearer <token>`, or a Collector running collector/config.yaml
# forwards it on their behalf from SENSORIUM_INGEST_TOKEN:
SENSORIUM_INGEST_TOKEN=
