{
  "name": "sensorium",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,md}\"",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "bun run packages/db/src/cli.ts migrate",
    "db:register-project": "bun run packages/db/src/cli.ts register-project"
  },
  "devDependencies": {
    "@sensorium/eslint-config": "workspace:*",
    "@types/bun": "^1.3.13",
    "eslint": "^9.39.1",
    "prettier": "^3.7.4",
    "turbo": "^2.10.3",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.3.13"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
